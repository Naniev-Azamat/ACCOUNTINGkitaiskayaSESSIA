@using kitaiskayaSESSIA.ViewModels
@model LoginViewModel
@{
    ViewData["Title"] = "Вход";
}

<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-logo"><i class="bi bi-wallet2"></i></div>
        <h1>С возвращением 👋</h1>
        <p class="sub">Войдите, чтобы продолжить учёт финансов</p>

        <div class="hint-box">
            <i class="bi bi-info-circle"></i>
            <b>Сотрудник:</b> любое имя + пароль <b>1234</b>

            <br><b>Директор:</brb> имя <b>директор</b>, пароль <b>4321</b>
        </div>

        <form asp-controller="Account" asp-action="Login" method="post">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="flash flash-error">
                    <i class="bi bi-exclamation-circle"></i>
                    <span>@Html.ValidationSummary(false)</span>
                </div>
            }

            <div class="field">
                <label asp-for="Name">Имя</label>
                <input asp-for="Name" class="input" placeholder="Например: Азамат" autofocus />
            </div>
            <div class="field">
                <label asp-for="Password">Пароль</label>
                <input asp-for="Password" class="input" placeholder="••••" />
            </div>

            <button type="submit" class="btn btn-primary btn-block">
                <i class="bi bi-box-arrow-in-right"></i> Войти
            </button>
        </form>
    </div>
</div>